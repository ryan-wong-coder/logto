{
  "tags": [
    {
      "name": "User assets",
      "description": "Endpoints for managing user uploaded assets."
    }
  ],
  "paths": {
    "/api/user-assets/service-status": {
      "get": {
        "summary": "Get service status",
        "description": "Get user assets service status.",
        "responses": {
          "200": {
            "description": "An object containing the service status and metadata."
          }
        }
      }
    },
    "/api/user-assets": {
      "post": {
        "summary": "Upload asset",
        "description": "Upload a user asset.",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "description": "The file asset to upload."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An object containing the uploaded asset metadata."
          }
        }
      }
    },
    "/api/user-assets/files/{assetPath}": {
      "get": {
        "summary": "Get a locally stored public user asset",
        "description": "Returns an immutable public asset from self-hosted local storage. The URL is generated by an upload endpoint and scoped to the current tenant.",
        "tags": ["Self-hosted parity"],
        "parameters": [
          {
            "name": "assetPath",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "The uploaded asset." },
          "404": { "description": "The asset does not exist." }
        }
      }
    }
  }
}
